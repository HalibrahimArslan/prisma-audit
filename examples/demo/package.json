{
  "name": "demo",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:generate": "prisma-audit generate --schema prisma/schema.prisma",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "migrate": "prisma migrate dev --name init",
    "demo": "tsx src/example.ts",
    "verify": "tsx src/verify.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "prisma-audit": "workspace:*"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
