// This is the schema you edit. It uses prisma-audit annotations, so it is not
// handed to the Prisma CLI directly: `prisma-audit generate` strips them and
// writes a Prisma-ready schema into prisma/.audit.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts and from the driver
// adapter passed to PrismaClient, not from the schema.
datasource db {
  provider = "postgresql"
}

enum Currency {
  TRY
  USD
}

[Auditable]
model Product {
  id       Int      @id @default(autoincrement())
  name     String
  price    Decimal  @db.Decimal(12, 2)
  currency Currency @default(TRY)

  // Internal bookkeeping that should never end up in the audit trail.
  [NotAudited]
  internalCode String?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  [NotAudited]
  updatedAt DateTime @updatedAt

  stock Stock?
}

// The audit table is named explicitly here: the generated model becomes
// StockHistory and the table stock_history.
[Auditable]
[AuditTable(StockHistory)]
model Stock {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  quantity  Int
  product   Product @relation(fields: [productId], references: [id])
}

// An aggregate root: [AuditedRelation] says its lines are part of it, so the
// order's history can be read together with theirs.
[Auditable]
model Order {
  id     Int    @id @default(autoincrement())
  status String

  [AuditedRelation]
  lines OrderLine[]
}

// A model keyed by two columns. The audit table is keyed the same way, on
// @@id([revisionId, orderId, lineNo]), and the reader takes the whole key.
[Auditable]
model OrderLine {
  orderId  Int
  lineNo   Int
  quantity Int
  note     String?
  order    Order   @relation(fields: [orderId], references: [id])

  @@id([orderId, lineNo])
}

// Enforced below the application: [AuditTriggers] says a database trigger
// writes this model's audit rows, so a raw UPDATE that never went through
// Prisma is recorded too. It is also mapped onto names of its own, which the
// generated SQL has to spell out rather than go through Prisma for.
[Auditable]
[AuditTriggers]
model Payment {
  id      Int     @id @default(autoincrement())
  orderId Int     @map("order_id")
  amount  Decimal @db.Decimal(12, 2)
  status  String

  @@map("payment")
}

// Not annotated: writes to Category leave no audit trail.
model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}
